import camion.*
import cosas.*

describe "group of test for camion" {

  test "peso de bumblebee" {
    camion.subirCarga(bumblebee)
    bumblebee.transformarEnRobot()
     assert.that(camion.peso() == 1000 + 800)
  }

  test "peso de arena a granel" {
    camion.subirCarga(arenaAGranel)
    assert.that(camion.peso() == 1000 + 100)
  }

  test "peso de batería antiaérea" {
    camion.subirCarga(bateriaAntiaerea)
    assert.that(camion.peso() == 1000 + 300)
  }

  test "peso embalaje con 80 ladrillos" {
    camion.subirCarga(embalajeDeSeguridad)
    embalajeDeSeguridad.cambiarObjeto(paqueteDeLadrillos)
    paqueteDeLadrillos.agregarLadrillos(78)
     assert.that(camion.peso() == 1000 + 160)
  }
}